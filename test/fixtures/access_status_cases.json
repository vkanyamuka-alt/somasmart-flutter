{
  "about": "Access rule cases shared by the website (src/lib/accessStatus.test.js) and the Flutter app (test/features/account/access_status_cases_test.dart). Same file in both repos: src/lib/accessStatusCases.json and test/fixtures/access_status_cases.json. The rule copies public.has_active_subscription.",
  "now": "2026-10-29T12:00:00Z",
  "cases": [
    {
      "name": "paid month with 15 days to go",
      "profile": { "subscription_status": "paid", "subscription_expires_at": "2026-11-13T12:00:00Z", "created_at": "2026-08-01T00:00:00Z" },
      "expect": { "kind": "paid", "days": 15, "endsAt": "2026-11-13T12:00:00Z" }
    },
    {
      "name": "paid, last few hours count as 1 day",
      "profile": { "subscription_status": "paid", "subscription_expires_at": "2026-10-29T20:00:00Z", "created_at": "2026-08-01T00:00:00Z" },
      "expect": { "kind": "paid", "days": 1, "endsAt": "2026-10-29T20:00:00Z" }
    },
    {
      "name": "paid but the month has ended (status is still 'paid' in the database)",
      "profile": { "subscription_status": "paid", "subscription_expires_at": "2026-09-10T08:00:00Z", "created_at": "2026-08-01T00:00:00Z" },
      "expect": { "kind": "expired", "days": null, "endsAt": null }
    },
    {
      "name": "paid with no expiry date gives no access (the server needs a date)",
      "profile": { "subscription_status": "paid", "subscription_expires_at": null, "created_at": "2026-08-01T00:00:00Z" },
      "expect": { "kind": "expired", "days": null, "endsAt": null }
    },
    {
      "name": "free account, 2 days old: trial with 4 days",
      "profile": { "subscription_status": "free", "subscription_expires_at": null, "created_at": "2026-10-27T12:00:00Z" },
      "expect": { "kind": "trial", "days": 4, "endsAt": "2026-11-02T12:00:00Z" }
    },
    {
      "name": "brand-new account: 6 trial days",
      "profile": { "subscription_status": "free", "created_at": "2026-10-29T12:00:00Z" },
      "expect": { "kind": "trial", "days": 6, "endsAt": "2026-11-04T12:00:00Z" }
    },
    {
      "name": "trial, last hour counts as 1 day",
      "profile": { "subscription_status": "free", "created_at": "2026-10-23T12:30:00Z" },
      "expect": { "kind": "trial", "days": 1, "endsAt": "2026-10-29T12:30:00Z" }
    },
    {
      "name": "trial ended exactly 6 days after sign-up",
      "profile": { "subscription_status": "free", "created_at": "2026-10-23T12:00:00Z" },
      "expect": { "kind": "expired", "days": null, "endsAt": null }
    },
    {
      "name": "old sign-up expiry date is ignored: trial comes from created_at only",
      "profile": { "subscription_status": "free", "subscription_expires_at": "2027-04-01T00:00:00Z", "created_at": "2026-10-01T00:00:00Z" },
      "expect": { "kind": "expired", "days": null, "endsAt": null }
    },
    {
      "name": "phone clock behind the server: still the trial, at most 6 days",
      "profile": { "subscription_status": "free", "created_at": "2026-10-29T14:00:00Z" },
      "expect": { "kind": "trial", "days": 6, "endsAt": "2026-11-04T14:00:00Z" }
    },
    {
      "name": "paid month beats a running trial",
      "profile": { "subscription_status": "paid", "subscription_expires_at": "2026-11-28T12:00:00Z", "created_at": "2026-10-27T12:00:00Z" },
      "expect": { "kind": "paid", "days": 30, "endsAt": "2026-11-28T12:00:00Z" }
    },
    {
      "name": "free access from an admin: no end date",
      "profile": { "subscription_status": "free", "free_access": true, "created_at": "2026-01-01T00:00:00Z" },
      "expect": { "kind": "paid", "days": null, "endsAt": null }
    },
    {
      "name": "admin: no end date",
      "profile": { "role": "admin", "subscription_status": "free", "created_at": "2026-01-01T00:00:00Z" },
      "expect": { "kind": "paid", "days": null, "endsAt": null }
    },
    {
      "name": "no dates at all: expired, never a made-up default",
      "profile": {},
      "expect": { "kind": "expired", "days": null, "endsAt": null }
    }
  ]
}
